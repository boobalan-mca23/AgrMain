{
  "name": "agr-jewellery-desktop",
  "version": "1.4.7",
  "description": "AGR Jewellery Management Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -k \"npm --prefix server run dev\" \"npm --prefix client run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:client": "npm --prefix client run build",
    "dist": "npm run build:client && electron-builder",
    "dist:win": "npm run build:client && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "build": {
    "appId": "com.agr.jewellery.desktop",
    "productName": "AGR Jewellery Management",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "compression": "normal",
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "client/dist/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "AGR Tech <support@agr.com>",
      "extraFiles": [
        {
          "from": "server",
          "to": "server",
          "filter": [
            "**/*",
            "!**/*.log",
            "!backup.sql",
            "!out.txt",
            "!err.txt",
            "!output.txt",
            "!uploads/**/*",
            "!node_modules/.cache/**/*",
            "!node_modules/**/*.map",
            "!node_modules/**/*.md",
            "!node_modules/**/*.d.ts",
            "!node_modules/**/test/**/*",
            "!node_modules/**/tests/**/*",
            "!node_modules/**/__tests__/**/*",
            "!node_modules/**/docs/**/*",
            "!node_modules/**/example/**/*",
            "!node_modules/**/examples/**/*",
            "!node_modules/**/*.exe",
            "!node_modules/**/*.dll.node"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "asar": true,
      "forceCodeSigning": false,
      "extraFiles": [
        {
          "from": "server",
          "to": "server",
          "filter": [
            "**/*",
            "!**/*.log",
            "!backup.sql",
            "!out.txt",
            "!err.txt",
            "!output.txt",
            "!uploads/**/*",
            "!node_modules/.cache/**/*",
            "!node_modules/**/*.map",
            "!node_modules/**/*.md",
            "!node_modules/**/*.d.ts",
            "!node_modules/**/test/**/*",
            "!node_modules/**/tests/**/*",
            "!node_modules/**/__tests__/**/*",
            "!node_modules/**/docs/**/*",
            "!node_modules/**/example/**/*",
            "!node_modules/**/examples/**/*",
            "!node_modules/**/*rhel*",
            "!node_modules/**/*.so.node",
            "!node_modules/**/schema-engine-linux*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Gurunath-S",
      "repo": "AgrMain"
    }
  },
  "keywords": [
    "electron",
    "jewellery",
    "management",
    "agr"
  ],
  "author": "AGR Tech <support@agr.com>",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  }
}
